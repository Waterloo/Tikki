// One Worker serves the SPA (static assets), the REST API, OAuth, and the MCP endpoint.
// The top level is local development (`pnpm dev`). `env.production` is deployed by Workers Builds from main.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ticketing",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything else is a static file or the SPA shell, so the Worker does not run (and costs no CPU) for it.
    "run_worker_first": ["/api/*", "/mcp", "/.well-known/*"]
  },
  "observability": { "enabled": true },
  // Delivers webhook Events from the outbox. Cron Triggers are on the Free plan; Queues are not (2.5).
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_ENV": "development",
    "APP_URL": "http://localhost:8787",
    "MAIL_TRANSPORT": "console",
    "ALLOWED_EMAIL_DOMAINS": "example.com",
    "ADMIN_EMAIL": "admin@example.com"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ticketing-dev", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // Private bucket. Files are served only through the Worker (7.1). Local dev and tests use the local R2 simulation.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "ticketing-files-dev" }],
  "env": {
    // Deployed by Cloudflare Workers Builds from `main` (DECISIONS 11.x). Self-hosters: change these values.
    "production": {
      "name": "tikki",
      "routes": [{ "pattern": "tikki.jithinsha.in", "custom_domain": true }],
      "vars": {
        "APP_ENV": "production",
        "APP_URL": "https://tikki.jithinsha.in",
        "MAIL_TRANSPORT": "cloudflare",
        "MAIL_FROM": "noreply@tikki.jithinsha.in",
        "ALLOWED_EMAIL_DOMAINS": "jithinsha.in",
        "ADMIN_EMAIL": "hello@jithinsha.in"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "tikki", "database_id": "93e85fbc-8333-463f-8b9a-7d0dc18f77dd", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "tikki-files" }],
      "send_email": [{ "name": "EMAIL" }]
    }
  }
}
