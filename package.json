{
  "name": "giggle-ticketing-system",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt build && wrangler dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "nuxt typecheck",
    "lint:migrations": "jiti scripts/lint-migrations.ts",
    "test": "pnpm lint:migrations && nuxt build && vitest run",
    "e2e": "playwright test",
    "postinstall": "nuxt prepare",
    "auth:generate": "auth generate --config scripts/auth-schema.config.ts --output server/db/auth-schema.ts --yes"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.10",
    "@better-auth/drizzle-adapter": "1.7.10",
    "@better-auth/mcp": "1.7.10",
    "@better-auth/oauth-provider": "1.7.10",
    "@modelcontextprotocol/server": "2.3.1",
    "@nuxt/ui": "4.12.0",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "jose": "^6.2.12",
    "nuxt": "4.6.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "@parcel/watcher",
      "sharp"
    ]
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@iconify-json/lucide": "^1.2.145",
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "auth": "1.7.10",
    "drizzle-kit": "0.31.11",
    "jiti": "2.7.0",
    "miniflare": "4.20260730.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13",
    "wrangler": "4.151.1"
  }
}
